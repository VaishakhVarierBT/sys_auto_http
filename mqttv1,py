        {
            "passcode": PASSCODE,
            "command": "setWill",
            "status": "1",
            "topic": "test/will",
            "payload": "offline",
            "qos": "1",
            "retain": "1",
        }
    )
    return res is not None, f"{res} | lat={lat}ms"


def get_will():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "getWill"})
    return res is not None, f"{res} | lat={lat}ms"


def publish_topic():
    # Kept at the current default (<MAC>/status) on purpose: changing it to
    # something else would redirect all further replies away from the
    # topic this script listens on.
    res, lat = send_and_wait(
        {"passcode": PASSCODE, "command": "publish", "topic": f"{MAC}/status", "qos": "0"}
    )
    return res is not None, f"{res} | lat={lat}ms"


def get_publish():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "getPublish"})
    return res is not None, f"{res} | lat={lat}ms"


def configure_udp():
    return config_flow(
        {
            "passcode": PASSCODE,
            "command": "config",
            "udpIp": "239.0.1.5",
            "udpPort": "49152",
            "udpStatus": "1",
        }
    )


def set_boot_delay():
    ok1, obs1 = config_flow(
        {"passcode": PASSCODE, "command": "config", "bootDelay": BOOT_DELAY_TEST_VALUE},
        {"bootDelay": BOOT_DELAY_TEST_VALUE},
    )
    ok2, obs2 = config_flow(
        {"passcode": PASSCODE, "command": "config", "bootDelay": "1"}, {"bootDelay": "1"}
    )
    return (ok1 and ok2), f"set={obs1} | restore={obs2}"


def set_product_name():
    return config_flow(
        {"passcode": PASSCODE, "command": "config", "productName": "Test_Device"},
        {"productName": "Test_Device"},
    )


def reboot():
    before_count, _ = get_reboot_log()

    _, lat = send_and_wait({"passcode": PASSCODE, "command": "reboot"})

    rebooted, dt = wait_for_reboot()
    up, obs = wait_product()

    after_count, _ = get_reboot_log()

    reboot_ok = (
        before_count is not None and after_count is not None and after_count > before_count
    )

    return rebooted and up and reboot_ok, (
        f"{obs} | reboot_dt={dt}s | "
        f"rebootCount:{before_count}->{after_count} | cmd_lat={lat}ms"
    )


def ntp_settings():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "ntpSettings"})
    return res is not None, f"{res} | lat={lat}ms"


def set_network_type():
    return config_flow(
        {"passcode": PASSCODE, "command": "config", "networkType": "1"},
        {"networkType": "1"},
    )


def set_ota_secure():
    return config_flow(
        {"passcode": PASSCODE, "command": "config", "otaSecure": "1"}, {"otaSecure": "1"}
    )


