    return config_flow(
        {"passcode": PASSCODE, "command": "config", "ipType": "0"}, {"ipType": "0"}
    )


def set_uzid():
    TEST_UZID = "112233445566"
    print("\nSetting UZID...")

    res, _ = send_and_wait(
        {"passcode": PASSCODE, "command": "systemUzid", "value": TEST_UZID}
    )
    if not res:
        return False, "Failed to set UZID."

    print("Verifying new UZID...")
    res, _ = send_and_wait({"passcode": TEST_UZID, "command": "product"})
    if not res:
        return False, "Product failed with new UZID."

    print("Restoring original UZID...")
    res, _ = send_and_wait(
        {"passcode": TEST_UZID, "command": "systemUzid", "value": MAC}
    )
    if not res:
        return False, "Failed to restore original UZID."

    print("Verifying restored UZID...")
    res, _ = send_and_wait({"passcode": MAC, "command": "product"})
    if not res:
        return False, "Original UZID verification failed."

    return True, "UZID changed, verified and restored successfully."


def reboot_log_test():
    count, lat = get_reboot_log()
    return count is not None, f"rebootCount={count} | lat={lat}ms"


def get_auth():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "getAuthPath"})
    return res is not None, f"{res} | lat={lat}ms"


def perform_auth():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "performAuth"})
    return res is not None, f"{res} | lat={lat}ms"


def softap_enable_disable():
    res1, lat1 = send_and_wait({"passcode": PASSCODE, "command": "softap", "value": "1"})
    time.sleep(2)
    res2, lat2 = send_and_wait({"passcode": PASSCODE, "command": "softap", "value": "0"})
    ok = res1 is not None and res2 is not None
    return ok, f"enable={res1}(lat={lat1}ms) | disable={res2}(lat={lat2}ms)"


def get_board_detail():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "getBoardDetail"})
    return res is not None, f"{res} | lat={lat}ms"


def get_maintenance():
    res, lat = send_and_wait({"passcode": PASSCODE, "command": "getMaintenanceMode"})
    return res is not None, f"{res} | lat={lat}ms"


def touch_flow():
    res, _ = get_product()
    if not res:
        return False, "No product response"

    if "Touch" not in res.get("type", ""):
        return True, "Skipped (not touch device)"

    ok1, _ = send_and_wait(
        {"passcode": PASSCODE, "command": "touchDelay", "delayTime": "50"}
    )
    ok2, _ = send_and_wait({"passcode": PASSCODE, "command": "getEnableTouchPin"})
    ok3, _ = send_and_wait(
        {
            "passcode": PASSCODE,
            "command": "enableTouchPin",
            "params": ["1", "1", "1", "1", "1", "1"],
        }
    )

    return (ok1 is not None and ok2 is not None and ok3 is not None), "Touch flow executed"


def network_reset():
    # This restores default network settings (SSID/password/IP). The device
    # will very likely drop off Wi-Fi/MQTT after this -- that is expected.
    res, lat = send_and_wait(
        {"passcode": PASSCODE, "command": "reset", "value": "networkReset"}, retries=1
    )
    return res is not None, f"{res} | lat={lat}ms"


def final_reset():
    res, lat = send_and_wait(
        {"passcode": PASSCODE, "command": "reset", "value": "hardReset"}, retries=1
    )

    print("Waiting for device to reset...")
    time.sleep(8)

    check, _ = send_and_wait(
        {"passcode": PASSCODE, "command": "product"}, retries=1, timeout=3
    )

    if check is None:
        return True, "Device unresponsive after hard reset (expected)"

    return False, "Device still responding \u2192 reset may have failed"


def write_device_info():
    product, _ = get_product()
    board, _ = send_and_wait({"passcode": PASSCODE, "command": "getBoardDetail"})

    with open(TXT_FILE, "a") as f:
        f.write("===== DEVICE INFORMATION =====\n\n")
        f.write(f"Device MAC : {MAC}\n")
        f.write(f"Device IP (used for HTTP bootstrap) : {DEVICE_IP}\n")

        if product:
            f.write(f"Product Type : {product.get('type', 'N/A')}\n")

        f.write("\nProduct Response:\n")
        f.write(json.dumps(product, indent=4))

        f.write("\n\nBoard Detail Response:\n")
        f.write(json.dumps(board, indent=4))

        f.write("\n\n========================================\n\n")


# =========================
# RUNNER
# =========================
def run_all():
    write_device_info()

    tests = [
        ("Passcode", set_passcode, "Passcode should be set"),
        ("SRID", set_srid, "srID = 123456789ABC"),
        ("SoftAP Config", configure_softap, "SoftAP configured"),
        ("Server", set_server, "serverType=2,5 (MQTT kept alive)"),
        ("MQTT Alive", set_mqtt_alive, "mqttSetAlive=60"),
        ("Subscribe", subscribe_topic, "MQTT subscribe + reboot"),
        ("GetSubs", get_subs, "Subs list"),
        ("Unsubscribe", unsubscribe_topic, "MQTT unsubscribe"),
        ("SetWill", set_will, "Will set"),
        ("GetWill", get_will, "Will get"),
        ("Publish", publish_topic, "Publish topic unchanged"),
        ("GetPublish", get_publish, "Publish fetch"),
        ("UDP", configure_udp, "UDP config"),
        ("BootDelay", set_boot_delay, f"bootDelay={BOOT_DELAY_TEST_VALUE} then restore to 1"),
        ("ProductName", set_product_name, "productName=Test_Device"),
        # ("Ping", configure_ping, "Ping config"),
        ("Reboot", reboot, "Device reboot"),
        ("NTP", ntp_settings, "NTP response"),
        ("NetworkType", set_network_type, "networkType=1"),
        ("OTASecure", set_ota_secure, "otaSecure=1"),
        ("IPType", configure_network_settings, "ipType=0"),
        # ("Sensor Scan Time", sensorscantime, "badCommand expected"),
        ("UZID", set_uzid, "UZID set"),
        ("RebootLog", reboot_log_test, "rebootLog fetch"),
        ("GetAuth", get_auth, "Auth path"),
        ("PerformAuth", perform_auth, "Auth success"),
        ("SoftAP Enable/Disable", softap_enable_disable, "SoftAP toggled"),
        ("BoardDetail", get_board_detail, "Board info"),
        ("GetMaintenance", get_maintenance, "Maintenance get"),
        # ("SetMaintenance", set_maintenance, "Maintenance set"),
        ("TouchFlow", touch_flow, "Touch test"),
        ("NetworkReset", network_reset, "Network reset (connectivity loss expected)"),
        ("FinalReset", final_reset, "Hard reset"),
    ]

    results = []

    for name, func, expected in tests:
        print(f"\n\u25b6 {name}")
        start = time.time()

        try:
            success, obs = func()
        except Exception as e:
            success, obs = False, str(e)

        total = round(time.time() - start, 2)
        status = "PASS" if success else "FAIL"

        print(f"{status} ({total}s)")
        print(obs)

        observed_full = f"{obs} | total_time={total}s"

        log_csv(name, expected, observed_full, status)
        log_txt(name, expected, observed_full, status)

        results.append(
            {"test_name": name, "observed": observed_full, "status": status, "time": total}
        )

    print("\n==== SUMMARY ====")
